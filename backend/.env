APP_NAME="GenAI Interview Assist"

ENVIRONMENT="development"

EMBEDDING_MODEL="all-MiniLM-L6-v2"

GEMINI_MODEL="gemini-3.6-flash"
OPENAI_MODEL="gpt-4.1-mini"
GROQ_MODEL="openai/gpt-oss-120b"

DB_COLLECTION_NAME = "documents"

HF_HOME_PATH="storage/hf_cache"
HF_CACHE_PATH="storage/hf_models"
VECTOR_DB="storage/chroma_db"
DOC_STORAGE_PATH = "knowledge_base/java"
INGESTION_HISTORY_PATH = "storage/ingestion_history.txt"

EMBEDDING_DIMENSION=384

CHUNK_SIZE = 800
OVERLAP_SIZE = 200

LLM_PROVIDERS="groq,gemini,openai"
TOPK=15

RERANKER_PROVIDER="cross-encoder"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANK_TOPK=5

DEV_FRONTEND_URL="http://localhost:5173"
PROD_FRONTEND_URL = "https://senylabs.vercel.app"


